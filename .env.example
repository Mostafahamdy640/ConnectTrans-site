# ConnectTrans Environment Variables Template

# Node Server Configuration
PORT=3000
NODE_ENV=production

# JWT Authentication Secret (Used for signing and verifying tokens)
JWT_SECRET=connecttrans-secure-jwt-secret-2026-production

# Admin Portal Security Passcode
ADMIN_SECURITY_PASSCODE=admin2026

# PostgreSQL Database Configuration (Prisma / Drizzle / Cloud SQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/connecttrans
SQL_HOST=127.0.0.1
SQL_DB_NAME=connecttrans
SQL_USER=postgres
SQL_PASSWORD=password
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=password

# AI Studio and Gemini
GEMINI_API_KEY=
APP_URL=
