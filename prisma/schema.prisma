// ConnectTrans Production Database Schema - Prisma
// Datasource PostgreSQL & Prisma Client

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  company
  office
  vehicle_owner
  driver
}

enum EntityStatus {
  active
  pending
  suspended
  inactive
}

enum RequestStatus {
  open
  has_offers
  partially_accepted
  closed
  cancelled
}

enum OfferStatus {
  active
  accepted
  rejected
  exhausted
}

enum TripStatus {
  pending
  assigned
  loading
  in_progress
  delivered
  completed
  cancelled
}

model User {
  id             Int          @id @default(autoincrement())
  uid            String       @unique
  email          String       @unique
  passwordHash   String?      @map("password_hash")
  name           String
  phone          String       @unique
  role           UserRole     @default(company)
  governorate    String       @default("القاهرة")
  city           String?      @default("")
  status         EntityStatus @default(active)
  verifiedDocs   Boolean      @default(false) @map("verified_docs")
  walletBalance  Decimal      @default(0.00) @map("wallet_balance") @db.Decimal(12, 2)
  rating         Decimal      @default(5.00) @db.Decimal(3, 2)
  commercialReg  String?      @map("commercial_reg")
  nationalId     String?      @map("national_id")
  truckType      String?      @map("truck_type")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")

  companyProfile      Company?
  officeProfile       Office?
  vehicleOwnerProfile VehicleOwner?
  driverProfile       Driver?
  documents           Document[]
  notifications       Notification[]
  walletTransactions  WalletTransaction[]

  @@map("users")
}

model Company {
  id            String       @id
  userId        String       @unique @map("user_id")
  companyName   String       @map("company_name")
  commercialReg String       @map("commercial_reg")
  taxCard       String?      @map("tax_card")
  industry      String?      @default("عام")
  governorate   String
  city          String
  address       String?
  phone         String
  status        EntityStatus @default(active)
  createdAt     DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@map("companies")
}

model Office {
  id            String       @id
  userId        String       @unique @map("user_id")
  officeName    String       @map("office_name")
  licenseNumber String       @map("license_number")
  governorate   String
  city          String
  address       String?
  phone         String
  status        EntityStatus @default(active)
  createdAt     DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@map("offices")
}

model VehicleOwner {
  id          String       @id
  userId      String       @unique @map("user_id")
  ownerName   String       @map("owner_name")
  nationalId  String       @map("national_id")
  governorate String
  city        String
  phone       String
  status      EntityStatus @default(active)
  createdAt   DateTime     @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [uid], onDelete: Cascade)
  vehicles Vehicle[]

  @@map("vehicle_owners")
}

model Vehicle {
  id            String   @id
  ownerId       String   @map("owner_id")
  plateNumber   String   @map("plate_number")
  truckType     String   @map("truck_type")
  capacityTons  Decimal  @default(20.00) @map("capacity_tons") @db.Decimal(6, 2)
  chassisNumber String?  @map("chassis_number")
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at")

  owner VehicleOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("vehicles")
}

model Driver {
  id                String   @id
  userId            String   @unique @map("user_id")
  ownerId           String?  @map("owner_id")
  driverName        String   @map("driver_name")
  nationalId        String   @map("national_id")
  licenseNumber     String   @map("license_number")
  phone             String
  assignedVehicleId String?  @map("assigned_vehicle_id")
  status            String   @default("active")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@map("drivers")
}

model TransportRequest {
  id                String        @id
  requestNumber     String        @unique @map("request_number")
  creatorId         String        @map("creator_id")
  creatorType       String        @default("company") @map("creator_type")
  creatorName       String        @map("creator_name")
  creatorPhone      String        @map("creator_phone")
  fromGovernorate   String        @map("from_governorate")
  fromCity          String        @map("from_city")
  toGovernorate     String        @map("to_governorate")
  toCity            String        @map("to_city")
  pickupLocation    String?       @map("pickup_location")
  dropoffLocation   String?       @map("dropoff_location")
  truckType         String        @map("truck_type")
  cargoType         String        @map("cargo_type")
  weightTons        Decimal       @default(25.00) @map("weight_tons") @db.Decimal(6, 2)
  pricePerUnit      Decimal       @map("price_per_unit") @db.Decimal(10, 2)
  requiredQuantity  Int           @map("required_quantity")
  remainingQuantity Int           @map("remaining_quantity")
  acceptedQuantity  Int           @default(0) @map("accepted_quantity")
  status            RequestStatus @default(open)
  notes             String?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at")

  offers      OfficeOffer[]
  acceptances RequestAcceptance[]
  trips       Trip[]

  @@map("transport_requests")
}

model OfficeOffer {
  id                  String      @id
  requestId           String      @map("request_id")
  requestNumber       String      @map("request_number")
  officeId            String      @map("office_id")
  officeName          String      @map("office_name")
  officePhone         String      @map("office_phone")
  offeredPricePerUnit Decimal     @map("offered_price_per_unit") @db.Decimal(10, 2)
  availableQuantity   Int         @map("available_quantity")
  remainingQuantity   Int         @map("remaining_quantity")
  acceptedQuantity    Int         @default(0) @map("accepted_quantity")
  truckTypesAvailable String      @map("truck_types_available")
  notes               String?
  status              OfferStatus @default(active)
  createdAt           DateTime    @default(now()) @map("created_at")

  request TransportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("office_offers")
}

model RequestAcceptance {
  id               String   @id
  requestId        String   @map("request_id")
  offerId          String?  @map("offer_id")
  acceptedByRole   String   @map("accepted_by_role")
  acceptedById     String   @map("accepted_by_id")
  acceptedByName   String   @map("accepted_by_name")
  acceptedByPhone  String   @map("accepted_by_phone")
  acceptedQuantity Int      @map("accepted_quantity")
  pricePerUnit     Decimal  @map("price_per_unit") @db.Decimal(10, 2)
  totalPrice       Decimal  @map("total_price") @db.Decimal(12, 2)
  status           String   @default("confirmed")
  createdAt        DateTime @default(now()) @map("created_at")

  request TransportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  trips   Trip[]

  @@map("request_acceptances")
}

model Trip {
  id              String     @id
  tripNumber      String     @unique @map("trip_number")
  requestId       String     @map("request_id")
  acceptanceId    String     @map("acceptance_id")
  offerId         String?    @map("offer_id")
  shipperId       String     @map("shipper_id")
  shipperName     String     @map("shipper_name")
  shipperPhone    String?    @map("shipper_phone")
  transporterId   String     @map("transporter_id")
  transporterName String     @map("transporter_name")
  transporterPhone String?   @map("transporter_phone")
  driverId        String?    @map("driver_id")
  driverName      String?    @map("driver_name")
  driverPhone     String?    @map("driver_phone")
  vehiclePlate    String?    @map("vehicle_plate")
  fromLocation    String     @map("from_location")
  toLocation      String     @map("to_location")
  cargoType       String     @map("cargo_type")
  weightTons      Decimal?   @map("weight_tons") @db.Decimal(6, 2)
  price           Decimal    @db.Decimal(10, 2)
  commission      Decimal?   @default(0.00) @db.Decimal(10, 2)
  status          TripStatus @default(pending)
  currentLocation String?    @default("نقطة التحميل") @map("current_location")
  latitude        Decimal?   @db.Decimal(10, 6)
  longitude       Decimal?   @db.Decimal(10, 6)
  progressPercent Int?       @default(0) @map("progress_percent")
  startedAt       DateTime?  @map("started_at")
  completedAt     DateTime?  @map("completed_at")
  createdAt       DateTime   @default(now()) @map("created_at")

  request    TransportRequest    @relation(fields: [requestId], references: [id])
  acceptance RequestAcceptance   @relation(fields: [acceptanceId], references: [id])
  history    TripStatusHistory[]
  ratings    Rating[]

  @@map("trips")
}

model TripStatusHistory {
  id        Int      @id @default(autoincrement())
  tripId    String   @map("trip_id")
  status    String
  note      String?
  actorId   String?  @map("actor_id")
  actorName String?  @map("actor_name")
  timestamp DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("trip_status_history")
}

model Rating {
  id           String   @id
  tripId       String   @map("trip_id")
  tripNumber   String   @map("trip_number")
  fromUserId   String   @map("from_user_id")
  fromUserName String   @map("from_user_name")
  fromUserRole String   @map("from_user_role")
  toUserId     String   @map("to_user_id")
  toUserName   String   @map("to_user_name")
  toUserRole   String   @map("to_user_role")
  rating       Int
  comment      String?
  createdAt    DateTime @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("ratings")
}

model WalletTransaction {
  id          String   @id
  userId      String   @map("user_id")
  tripId      String?  @map("trip_id")
  type        String   // credit | debit | payout | commission_fee
  amount      Decimal  @db.Decimal(12, 2)
  description String
  status      String   @default("completed")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@map("wallet_transactions")
}

model Notification {
  id        String   @id
  userId    String   @map("user_id")
  title     String
  message   String
  type      String?  @default("system")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@map("notifications")
}

model Document {
  id           String    @id
  userId       String    @map("user_id")
  documentType String    @map("document_type")
  title        String
  fileUrl      String    @map("file_url")
  status       String    @default("pending") // pending | approved | rejected
  verifiedBy   String?   @map("verified_by")
  verifiedAt   DateTime? @map("verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@map("documents")
}

model AuditLog {
  id        String   @id
  actorId   String   @map("actor_id")
  actorName String   @map("actor_name")
  actorRole String   @map("actor_role")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  details   String?
  timestamp DateTime @default(now())

  @@map("audit_logs")
}

model CommissionProfile {
  id          String   @id
  name        String
  description String
  active      Boolean  @default(true)
  multiplier  Decimal  @default(1.00) @db.Decimal(4, 2)
  tiersJson   String   @map("tiers_json")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("commission_profiles")
}
